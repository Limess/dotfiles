{{ if and (eq .chezmoi.os "linux") (.chezmoi.kernel.osrelease | lower | contains "microsoft") -}}
# 1password
# The CLI here is the Windows op.exe (so it can use the desktop app's biometric
# unlock), and two accounts are signed in, so it needs OP_ACCOUNT to disambiguate.
# Select the other account per-command with `op --account enode`.
# WSL only forwards variables named in WSLENV across the Linux/Windows boundary.
{{ $account := index .onepassword.accounts .onepassword.defaultAccount -}}
export OP_ACCOUNT={{ $account.id }}  # {{ $account.email }}
export WSLENV="${WSLENV:+$WSLENV:}OP_ACCOUNT"
{{ end }}
# secrets
export GITHUB_USERNAME={{ onepasswordRead "op://personal/GITHUB_TOKEN/username" | quote }}
export HOMEBREW_GITHUB_API_TOKEN={{ onepasswordRead "op://personal/GITHUB_TOKEN/password" | quote }}

# krew (kubectl plugin manager) — put installed plugins on PATH
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"

export PATH="$HOME/.opencode/bin:$PATH"

# claude code — https://docs.anthropic.com/en/docs/claude-code/settings#environment-variables
export DISABLE_TELEMETRY=1
export CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY=1
export CLAUDE_CODE_NO_FLICKER=1
export CLAUDE_CODE_NEW_INIT=1

# docker
export DOCKER_SCAN_SUGGEST=false
export COMPOSE_BAKE=true

# your project folder that we can `c [tab]` to
export PROJECTS=~/Projects

# your default editor
export EDITOR='vim'
export VEDITOR='code'

# less
# Highlight section titles in manual pages.
export LESS_TERMCAP_md="${yellow}";
# https://github.com/sharkdp/bat/issues/2219#issuecomment-1645456156
export MANPAGER="sh -c 'sed -r \"s/\x1B\[([0-9]{1,3}(;[0-9]{1,2};?)?)?[mGK]//g\" | bat --language man --plain'"

{{ if eq .chezmoi.os "darwin" -}}
ulimit -n 9999
{{ end }}

# node.js
# Enable persistent REPL history for `node`.
export NODE_REPL_HISTORY=~/.node_history;
# Allow 32³ entries; the default is 1000.
export NODE_REPL_HISTORY_SIZE='32768';
# Use sloppy mode by default, matching web browsers.
export NODE_REPL_MODE='sloppy';

# fzf
export FZF_DEFAULT_OPTS="--height 100% --layout reverse --preview-window=wrap"
export FZF_CTRL_R_OPTS=""
export FZF_CTRL_T_OPTS="--preview 'bat --color=always {}'"
export FZF_ALT_C_OPTS="--preview '[ -d {} ] && tree -C {} || bat --color=always --style=numbers {}'"
export FZF_DEFAULT_COMMAND="rg --files --hidden --follow --glob '!.git'"
if command -v fzf &>/dev/null; then
  source <(fzf --zsh)
fi
