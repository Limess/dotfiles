# pick a worktree with fzf and cd into it
gwt() {
  local dir
  # display only the worktree directory name; the tab-separated full path stays in field 2 for preview/cd
  dir=$(git worktree list --porcelain | awk '/^worktree /{p=$2; n=p; sub(/.*\//, "", n); print n "\t" p}' \
    | fzf --height 40% --reverse --with-nth=1 --delimiter='\t' --preview 'git -C {2} log --oneline -10' \
    | cut -f2) || return
  [[ -n $dir ]] && cd "$dir"
}

# create a worktree for a new branch as a sibling directory, then cd into it
gwta() {
  local branch=$1
  if [[ -z $branch ]]; then
    print -u2 "usage: gwta <branch>"
    return 1
  fi
  local root dir
  root=$(git rev-parse --show-toplevel) || return
  dir="${root:h}/${root:t}-${branch//\//-}"
  git worktree add "$dir" -b "$branch" && cd "$dir"
}

