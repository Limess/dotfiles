#!/usr/bin/env bash
set -e

COMPLETIONS_PATH="$HOME/.zsh/completions"
[[ -n "$COMPLETIONS_PATH" ]] || exit 1

rm -rf "$COMPLETIONS_PATH"
mkdir -p "$COMPLETIONS_PATH/zsh"
mkdir -p "$COMPLETIONS_PATH/bash"

{{- if lookPath "kubectl" }}
kubectl completion zsh > "$COMPLETIONS_PATH/zsh/_kubectl"
{{ end }}

{{- if lookPath "chezmoi" }}
chezmoi completion zsh > "$COMPLETIONS_PATH/zsh/_chezmoi"
{{ end }}


{{- if lookPath "terraform" }}
cat > ~/.zsh/completions/bash/terraform.bash << 'EOF'
# Terraform bash completion
if command -v terraform >/dev/null 2>&1; then
  complete -C "$(which terraform)" terraform
fi
EOF
{{ end }}

{{- if lookPath "terragrunt" }}
cat > ~/.zsh/completions/bash/terragrunt.bash << 'EOF'
# terragrunt bash completion
if command -v terragrunt >/dev/null 2>&1; then
  complete -C "$(which terragrunt)" terragrunt
fi
EOF
{{ end }}

{{- if and (eq .chezmoi.os "darwin") (lookPath "op") }}
cat > ~/.zsh/completions/bash/op.bash << 'EOF'
# Cache `op completion zsh`; only regenerate when the op binary is newer than the cache.
_op_comp="${ZSH_CACHE_DIR:-$HOME/.cache/zsh}/op_completion.zsh"
if [[ ! -s $_op_comp || $(command -v op) -nt $_op_comp ]]; then
  op completion zsh >| $_op_comp 2>/dev/null
fi
source $_op_comp
compdef _op op
unset _op_comp
EOF
{{ end }}

cat > ~/.zsh/completions/bash/rush.bash << 'EOF'
# Rush has no static completion script; it answers per-keystroke via `rush tab-complete`.
# rush comes from a mise-managed npm shim, so guard at shell-startup time rather than at chezmoi apply time.
(( ${+commands[rush]} )) && {
  _rush_completion() {
    compadd -- $(rush tab-complete --position ${CURSOR} --word "${BUFFER}" 2>>/dev/null)
  }
  compdef _rush_completion rush
}
EOF

{{- if lookPath "xh" }}
# xh dropped `--generate complete-zsh` in 0.23; completions now only ship in the repo.
curl -fsS https://raw.githubusercontent.com/ducaale/xh/master/completions/_xh > "$COMPLETIONS_PATH/zsh/_xh"
{{ end }}

curl -fsS https://raw.githubusercontent.com/fishtown-analytics/dbt-completion.bash/master/_dbt > "$COMPLETIONS_PATH/zsh/_dbt"
