#!/usr/bin/env bash
#
# brew appends to ~/.homebrew/trust.json whenever a new tap, formula, or cask
# is trusted, so this unions the entries below into the live file rather than
# owning it. Removing an entry here doesn't remove it from the live file.

set -euo pipefail

if ! command -v jq >/dev/null; then
    echo "modify trust.json: jq not found, leaving file unchanged" >&2
    cat
    exit 0
fi

trusted=$(cat <<'EOF'
{
  "trustedformulae": [
    "coolcorexix/tap/claude-grep",
    "f1bonacc1/tap/process-compose"
  ],
  "trustedtaps": [
    "aquasecurity/trivy",
    "babashka/brew",
    "borkdude/brew",
    "common-fate/granted",
    "coolcorexix/tap",
    "cue-lang/tap",
    "derailed/k9s",
    "heroku/brew",
    "synfinatic/aws-sso-cli",
    "warrensbox/tap"
  ],
  "trustedcasks": [
    "aibrickai/lidrun/lidrun",
    "circleci-public/circleci/circleci@next"
  ]
}
EOF
)

# An absent target file arrives as empty stdin.
jq -n --argjson trusted "$trusted" '
  (try input catch {}) as $live
  | reduce ($trusted | keys_unsorted[]) as $key ($live;
      .[$key] = ((.[$key] // []) + ($trusted[$key] - (.[$key] // []))))
'
