{
  "env": {
    "NO_COLOR": "1",
    "GIT_PAGER": "cat",
    "AWS_JAVA_V1_DISABLE_DEPRECATION_ANNOUNCEMENT": "true",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8[1m]"
  },
  "permissions": {
    "allow": [
      "mcp__serena__*",
      "mcp__prometheus__*",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git status *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git tag *)",
      "Bash(git stash list *)",
      "Bash(git rev-parse *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(git pull *)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(date *)",
      "Bash(uname *)",
      "Bash(aws sts get-caller-identity*)",
      "Read(//tmp/spandex-072/spandex-0.7.2/**)",
      "Read(//home/charlie_briggs/.m2/repository/com/walmartlabs/lacinia/**)",
      "Read(//tmp/lacinia-src/com/walmartlabs/lacinia/**)",
      "WebFetch(domain:github.com)",
      "WebSearch",
      "Bash(/usr/bin/git diff *)",
      "Bash(/usr/bin/git show *)",
      "Bash(git commit -m 'Refactor msearch sub-query construction; lift signal keys to module constants *)",
      "Bash(git fetch *)",
      "Bash(git stash *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./**/.env*)",
      "Read(./**/profiles.clj)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(cat *profiles.clj*)",
      "Bash(head *profiles.clj*)",
      "Bash(tail *profiles.clj*)",
      "Bash(aws *)",
      "Bash(ssh *)",
      "Bash(cat */.aws/*)",
      "Bash(head */.aws/*)",
      "Bash(tail */.aws/*)",
      "Bash(cat */.ssh/*)",
      "Bash(head */.ssh/*)",
      "Bash(tail */.ssh/*)",
      "Read(~/.aws/*)",
      "Read(~/.ssh/*)",
      "Read(~/.dbt/*)",
      "mcp__serena__write_memory",
      "mcp__serena__read_memory",
      "mcp__serena__list_memories",
      "mcp__serena__delete_memory",
      "mcp__serena__rename_memory",
      "mcp__serena__edit_memory",
      "mcp__prometheus__get_targets",
      "mcp__prometheus__get_metric_metadata"
    ],
    "defaultMode": "auto"
  },
  "model": "sonnet",
  "hooks": {
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/notify.sh 'Claude Code needs your attention' 'Claude Code'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/oxfmt-after-edit.sh\"",
            "statusMessage": "Formatting with oxfmt"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/charlie_briggs/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh"
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": false,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "enode-skills@enode-internal": true
  },
  "extraKnownMarketplaces": {
    "enode-internal": {
      "source": {
        "source": "github",
        "repo": "enode/skills"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    }
  },
  "showThinkingSummaries": true,
  "theme": "dark",
  "voiceEnabled": true
}
